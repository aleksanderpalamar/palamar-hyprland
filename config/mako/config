# Notificações do Omarchy (default/mako/core.ini). As cores vêm do tema atual (hypr-theme).
include=~/.local/state/hypr-theme/mako.ini

anchor=top-right
group-by=app-name,summary,body
default-timeout=5000
width=420
outer-margin=20
padding=10,15
border-size=2
max-icon-size=32
font=sans-serif 14px

[app-name=Spotify]
invisible=1

# SUPER + CTRL + vírgula liga/desliga este modo.
[mode=do-not-disturb]
invisible=true

[mode=do-not-disturb app-name=notify-send]
invisible=false

[urgency=critical]
default-timeout=0
layer=overlay

[summary~="Screenshot copied & saved"]
max-icon-size=80
format=<b>%s</b>\n%b
