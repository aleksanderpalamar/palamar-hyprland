#!/usr/bin/env bash

# Lista os atalhos do Hyprland que têm descrição (SUPER + K), agrupados por
# seção. A lista vem do arquivo que o bind() do hyprland.lua grava, e não do
# hyprctl: ele devolve a tecla vazia nos binds com code:NN.
set -u

state=${XDG_STATE_HOME:-$HOME/.local/state}
list=$state/hypr/keybindings.tsv

menu() {
    fuzzel --dmenu --prompt "Atalhos  " --width 80 --lines "$1" \
        --font "JetBrainsMono Nerd Font:size=11" >/dev/null
}

if [[ ! -r $list ]]; then
    printf '%s\n' "Lista indisponível — recarregue o Hyprland (SUPER + R)." | menu 1
    exit 0
fi

awk -F'\t' '
    function keyname(key) {
        if (key == "code:49") return "\47"
        if (key == "code:20") return "-"
        if (key == "code:21") return "="
        if (key ~ /^code:1[0-9]$/) return (substr(key, 6) - 9) % 10
        if (key == "mouse:272") return "botão esquerdo"
        if (key == "mouse:273") return "botão direito"
        if (key == "mouse_down") return "rolar para baixo"
        if (key == "mouse_up") return "rolar para cima"
        return key
    }
    {
        n = split($2, parts, / *\+ */)
        combo = ""
        for (i = 1; i <= n; i++) {
            combo = combo (i == 1 ? "" : " + ") (i == n ? keyname(parts[i]) : parts[i])
        }
        line = sprintf("%-34s  %s", combo, $3)
        if (seen[$1 FS line]++) next
        if (!($1 in items)) order[++groups] = $1
        items[$1] = items[$1] line "\n"
    }
    END {
        for (i = 1; i <= groups; i++) {
            printf "──  %s\n%s", order[i], items[order[i]]
        }
    }
' "$list" | menu 18
